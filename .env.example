# Archivo de configuración de variables de entorno
# Copia este archivo como .env y rellena tus valores

# ==============================
# Binance API (Opcional en modo PAPER)
# ==============================
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ==============================
# Trading
# ==============================
TRADING_SYMBOL=BTCUSDT
TRADING_MODE=PAPER       # PAPER | LIVE
BOT_QUANTITY=0.001

# ==============================
# Estrategia MA Crossover
# ==============================
BOT_MA_FAST=7
BOT_MA_SLOW=25

# ==============================
# Base de Datos
# ==============================
# DB_PATH=trading_bot.db   # Ruta relativa a la raíz del proyecto
